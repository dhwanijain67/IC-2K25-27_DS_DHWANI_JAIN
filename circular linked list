#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

int main() {
    Node *a = new Node{20, NULL};
    Node *b = new Node{30, NULL};
    Node *c = new Node{40, NULL};

    a->next = b;
    b->next = c;
    c->next = a;

    Node* t = a;

    do {
        cout << t->data << " ";
        t = t->next;
    } while (t != a);

    return 0;
}
